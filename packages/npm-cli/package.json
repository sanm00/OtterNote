{
  "name": "otter-note",
  "version": "0.1.0",
  "description": "Installer and launcher for the OtterNote desktop app (macOS and Linux)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanm00/OtterNote.git",
    "directory": "packages/npm-cli"
  },
  "homepage": "https://github.com/sanm00/OtterNote",
  "bugs": {
    "url": "https://github.com/sanm00/OtterNote/issues"
  },
  "bin": {
    "otter-note": "bin/otter-note.js"
  },
  "files": [
    "bin",
    "lib",
    "scripts/install.sh",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "otternote",
    "notes",
    "todo",
    "markdown",
    "tauri",
    "desktop"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-npm-release.mjs",
    "prepack": "node scripts/sync-install-script.js",
    "postinstall": "node bin/otter-note.js postinstall"
  }
}
